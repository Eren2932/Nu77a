# =============================================================================
# Nuva server environment.
#
# Copy to .env and fill in. The server refuses to start when a required
# variable is missing, so there is no such thing as a "forgotten variable"
# that only breaks in production.
#
#   cp .env.example .env
#   ./scripts/gen-secrets.sh      # fills the two secrets below
# =============================================================================

# --- required ---------------------------------------------------------------
# 32+ random characters. Rotating this signs everyone out. Never commit it.
NUVA_JWT_SECRET=

# Postgres password used by both the db and the server service.
POSTGRES_PASSWORD=

# --- server -----------------------------------------------------------------
NUVA_ENV=production
NUVA_PORT=8080
NUVA_DATABASE_URL=postgres://nuva:${POSTGRES_PASSWORD}@db:5432/nuva?sslmode=disable
NUVA_ACCESS_TTL=15m
NUVA_REFRESH_TTL=1440h
NUVA_MEDIA_DIR=/data/media
NUVA_MAX_UPLOAD_MB=100
# Comma separated. Used for CORS and for WebSocket origin checks in production.
NUVA_ALLOWED_ORIGINS=https://nuva.club,https://app.nuva.club

# --- postgres ---------------------------------------------------------------
POSTGRES_USER=nuva
POSTGRES_DB=nuva

# --- caddy (TLS) ------------------------------------------------------------
# The domain that points at this server. Caddy gets a certificate for it
# automatically on first boot.
NUVA_DOMAIN=api.nuva.club
# Let's Encrypt uses this address for expiry warnings.
NUVA_ACME_EMAIL=you@example.com
