<?xml version="1.0" encoding="utf-8"?>
<!--
  Icon background: Nuva ink with a soft violet aurora in the upper left.
  A gradient is allowed here and nowhere else in the app: launcher icons are
  judged next to dozens of others and a flat square disappears.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF3A2E8C" />
                <item android:offset="0.55" android:color="#FF171B2E" />
                <item android:offset="1" android:color="#FF0B0E12" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
